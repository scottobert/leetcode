{
  "name": "openfec-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the OpenFEC API (U.S. Federal Election Commission campaign finance data)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openfec-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=bin/index.cjs",
    "prepare-plugin": "npm run typecheck && npm run bundle",
    "clean": "rm -rf dist bin"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
