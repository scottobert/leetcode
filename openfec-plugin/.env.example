# OpenFEC API key (api.data.gov). Register free at:
#   https://api.open.fec.gov/developers/
#
# Export this in the shell where you launch Claude Code so the bundled MCP
# server inherits it. Without it the server falls back to the rate-limited
# DEMO_KEY (a few requests per hour).
#
#   export OPENFEC_API_KEY="your-key-here"

OPENFEC_API_KEY=
